{
	"name": "@firtoz/drizzle-utils",
	"version": "1.3.0",
	"description": "Shared utilities and types for Drizzle-based packages",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./sqlite-table-sync": {
			"types": "./dist/sqlite-table-sync/index.d.ts",
			"import": "./dist/sqlite-table-sync/index.js",
			"require": "./dist/sqlite-table-sync/index.js",
			"default": "./dist/sqlite-table-sync/index.js"
		},
		"./sqlite-table-sync/*": {
			"types": "./dist/sqlite-table-sync/*.d.ts",
			"import": "./dist/sqlite-table-sync/*.js",
			"require": "./dist/sqlite-table-sync/*.js",
			"default": "./dist/sqlite-table-sync/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js",
			"require": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"drizzle",
		"utils"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/drizzle-utils"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@tanstack/db": ">=0.6.5",
		"drizzle-orm": ">=0.45.2",
		"drizzle-valibot": ">=0.4.0",
		"valibot": ">=1.3.1"
	},
	"devDependencies": {
		"@tanstack/db": "catalog:",
		"drizzle-orm": "catalog:",
		"drizzle-valibot": "catalog:",
		"valibot": "catalog:"
	},
	"dependencies": {
		"@firtoz/db-helpers": "workspace:*",
		"@firtoz/maybe-error": "workspace:*"
	}
}
