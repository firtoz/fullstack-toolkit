{
	"name": "@firtoz/router-toolkit",
	"version": "9.0.2",
	"description": "Type-safe React Router 7 framework mode helpers with enhanced fetching, form submission, and state management",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types/*": {
			"types": "./dist/types/*.d.ts",
			"import": "./dist/types/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!test-setup.ts",
		"!bunfig.toml",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"keywords": [
		"react-router",
		"react-router-7",
		"framework-mode",
		"hooks",
		"typescript",
		"form-submission",
		"fetching",
		"type-safe"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/router-toolkit"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-router": "catalog:",
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@firtoz/maybe-error": "workspace:*",
		"zod-form-data": "catalog:"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.1",
		"@types/jsdom": "^28.0.3",
		"@types/react": "catalog:",
		"bun-types": "catalog:",
		"jsdom": "^29.1.1"
	}
}
