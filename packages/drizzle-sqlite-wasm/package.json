{
	"name": "@firtoz/drizzle-sqlite-wasm",
	"version": "1.1.0",
	"description": "Drizzle SQLite WASM bindings",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./drizzle-sqlite-wasm-worker": {
			"types": "./dist/drizzle/worker.d.ts",
			"import": "./dist/drizzle/worker.js"
		},
		"./sqlite-wasm-migrator": {
			"types": "./dist/migration/migrator.d.ts",
			"import": "./dist/migration/migrator.js"
		},
		"./drizzleCollectionOptions": {
			"types": "./dist/collections/sqlite-collection.d.ts",
			"import": "./dist/collections/sqlite-collection.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"sqlite",
		"wasm",
		"drizzle"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/drizzle-sqlite-wasm"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@firtoz/collection-sync": "workspace:*",
		"@firtoz/db-helpers": "workspace:*",
		"@firtoz/drizzle-utils": "workspace:*",
		"@firtoz/maybe-error": "workspace:*",
		"@firtoz/worker-helper": "workspace:*",
		"@sqlite.org/sqlite-wasm": "catalog:",
		"@tanstack/db": "catalog:",
		"drizzle-orm": "catalog:",
		"drizzle-valibot": "catalog:",
		"react": "catalog:",
		"valibot": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@standard-schema/spec": "catalog:",
		"@types/react": "catalog:"
	}
}
