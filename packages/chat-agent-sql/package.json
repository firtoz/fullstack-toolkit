{
	"name": "@firtoz/chat-agent-sql",
	"version": "2.0.3",
	"description": "Raw SQL persistence for @firtoz/chat-agent on Cloudflare Durable Objects",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"durable-objects",
		"cloudflare",
		"chat",
		"ai"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/chat-agent-sql"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"peerDependencies": {
		"@firtoz/chat-agent": "^2.1.2",
		"@cloudflare/workers-types": "catalog:",
		"@openrouter/sdk": "catalog:",
		"agents": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@firtoz/chat-agent": "workspace:*"
	},
	"devDependencies": {
		"bun-types": "catalog:",
		"typescript": "catalog:"
	}
}
