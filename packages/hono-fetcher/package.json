{
	"name": "@firtoz/hono-fetcher",
	"version": "2.8.0",
	"description": "Type-safe Hono API client with full TypeScript inference for routes, params, and payloads",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./honoDoFetcher": {
			"types": "./dist/honoDoFetcher.d.ts",
			"import": "./dist/honoDoFetcher.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md"
	],
	"scripts": {
		"build": "tsup && tsc -p tsconfig.emit-index-dts.json",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"keywords": [
		"typescript",
		"hono",
		"api-client",
		"type-safe",
		"fetcher",
		"http-client",
		"durable-objects",
		"cloudflare"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/hono-fetcher"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"hono": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@hono/node-server": "^2.0.1",
		"@hono/zod-validator": "catalog:",
		"bun-types": "catalog:",
		"zod": "catalog:"
	}
}
