{
	"$schema": "../../node_modules/turbo/schema.json",
	"extends": ["//"],
	"tasks": {
		"typecheck": {
			"dependsOn": ["^build", "build"],
			"inputs": ["src/**", "tsconfig.json", "package.json", "tsup.config.ts", "tsconfig.emit-index-dts.json"]
		},
		"build": {
			"inputs": ["src/**", "tsconfig.json", "package.json", "tsup.config.ts", "tsconfig.emit-index-dts.json"]
		},
		"lint": {
			"inputs": ["src/**", "../../biome.json"]
		},
		"lint:ci": {
			"inputs": ["src/**", "../../biome.json"]
		},
		"test": {
			"inputs": ["src/**", "tsconfig.json", "package.json"]
		}
	}
}
