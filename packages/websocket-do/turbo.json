{
	"$schema": "../../node_modules/turbo/schema.json",
	"extends": ["//"],
	"tasks": {
		"typecheck": {
			"dependsOn": ["^build", "build"],
			"inputs": [
				"src/**",
				"examples/**",
				"tsconfig.json",
				"package.json"
			]
		},
		"lint": {
			"inputs": ["src/**", "../../biome.json"]
		},
		"lint:ci": {
			"inputs": ["src/**", "../../biome.json"]
		}
	}
}
