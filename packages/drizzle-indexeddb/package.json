{
	"name": "@firtoz/drizzle-indexeddb",
	"version": "3.0.1",
	"description": "IndexedDB migrations powered by Drizzle ORM",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"type": "module",
	"bin": {
		"drizzle-indexeddb-generate": "./src/bin/generate-migrations.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		},
		"./generate": {
			"types": "./src/bin/generate-migrations.ts",
			"import": "./src/bin/generate-migrations.ts",
			"require": "./src/bin/generate-migrations.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts",
			"require": "./src/*.ts"
		},
		"./*.tsx": {
			"types": "./src/*.tsx",
			"import": "./src/*.tsx",
			"require": "./src/*.tsx"
		}
	},
	"files": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"indexeddb",
		"drizzle",
		"migrations"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/drizzle-indexeddb"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@firtoz/drizzle-utils": ">=1.1.0",
		"@tanstack/db": ">=0.5.33",
		"drizzle-orm": ">=0.45.1",
		"drizzle-valibot": ">=0.4.0",
		"react": ">=19.2.4",
		"valibot": ">=1.3.1"
	},
	"devDependencies": {
		"@firtoz/drizzle-utils": "workspace:*",
		"@tanstack/db": "catalog:",
		"@types/react": "catalog:",
		"drizzle-orm": "catalog:",
		"drizzle-valibot": "catalog:",
		"react": "catalog:",
		"valibot": "catalog:"
	},
	"dependencies": {
		"@firtoz/db-helpers": "workspace:*",
		"@firtoz/idb-collections": "workspace:*",
		"@firtoz/maybe-error": "workspace:*",
		"citty": "^0.2.1"
	}
}
