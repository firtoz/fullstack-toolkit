{
	"name": "@firtoz/drizzle-indexeddb",
	"version": "5.0.3",
	"description": "IndexedDB migrations powered by Drizzle ORM",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"bin": {
		"drizzle-indexeddb-generate": "./dist/bin/generate-migrations.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./generate": {
			"types": "./dist/bin/generate-migrations.d.ts",
			"import": "./dist/bin/generate-migrations.js"
		},
		"./collections/*": {
			"types": "./dist/collections/*.d.ts",
			"import": "./dist/collections/*.js"
		},
		"./context/*": {
			"types": "./dist/context/*.d.ts",
			"import": "./dist/context/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup && bun ../../scripts/add-node-shebang.ts dist/bin/generate-migrations.js",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"indexeddb",
		"drizzle",
		"migrations"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/drizzle-indexeddb"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@firtoz/drizzle-utils": ">=1.3.2",
		"@tanstack/db": ">=0.6.7",
		"drizzle-orm": ">=0.45.2",
		"drizzle-valibot": ">=0.4.0",
		"react": ">=19.2.6",
		"valibot": ">=1.4.1"
	},
	"devDependencies": {
		"@firtoz/drizzle-utils": "workspace:*",
		"@tanstack/db": "catalog:",
		"@types/react": "catalog:",
		"drizzle-orm": "catalog:",
		"drizzle-valibot": "catalog:",
		"react": "catalog:",
		"valibot": "catalog:"
	},
	"dependencies": {
		"@firtoz/db-helpers": "workspace:*",
		"@firtoz/idb-collections": "workspace:*",
		"@firtoz/maybe-error": "workspace:*",
		"citty": "^0.2.2"
	}
}
