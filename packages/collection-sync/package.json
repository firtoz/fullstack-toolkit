{
	"name": "@firtoz/collection-sync",
	"version": "7.0.0",
	"description": "WebSocket sync protocol and bridges for TanStack DB collections",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		},
		"./react/*": {
			"types": "./dist/react/*.d.ts",
			"import": "./dist/react/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write",
		"test": "bun test src"
	},
	"keywords": [
		"typescript",
		"websocket",
		"sync",
		"tanstack-db"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/collection-sync"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@firtoz/db-helpers": "workspace:*",
		"@firtoz/maybe-error": "workspace:*",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@firtoz/websocket-do": "workspace:*",
		"@standard-schema/spec": ">=1.1.0",
		"@tanstack/db": ">=0.6.7",
		"@tanstack/react-db": ">=0.1.85",
		"react": ">=19.2.6"
	},
	"devDependencies": {
		"@firtoz/websocket-do": "workspace:*",
		"@standard-schema/spec": "catalog:",
		"@tanstack/db": "catalog:",
		"@tanstack/react-db": "catalog:",
		"@types/react": "catalog:",
		"react": "catalog:",
		"typescript": "catalog:"
	}
}
