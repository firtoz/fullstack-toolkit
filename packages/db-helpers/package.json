{
	"name": "@firtoz/db-helpers",
	"version": "2.2.0",
	"description": "TanStack DB helpers and utilities",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"prepack": "bun run build",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"test": "bun test",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"tanstack",
		"tanstack-db",
		"db-helpers"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/db-helpers"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@standard-schema/spec": ">=1.1.0",
		"@tanstack/db": ">=0.6.5"
	},
	"devDependencies": {
		"@standard-schema/spec": "catalog:",
		"@tanstack/db": "catalog:",
		"bun-types": "catalog:",
		"zod": "catalog:"
	},
	"dependencies": {
		"@firtoz/maybe-error": "workspace:*"
	}
}
