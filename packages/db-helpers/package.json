{
	"name": "@firtoz/db-helpers",
	"version": "2.0.0",
	"description": "TanStack DB helpers and utilities",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		}
	},
	"files": [
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p ./tsconfig.json",
		"test": "bun test",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src",
		"format": "biome format src --write"
	},
	"keywords": [
		"typescript",
		"tanstack",
		"tanstack-db",
		"db-helpers"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/db-helpers"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@standard-schema/spec": ">=1.1.0",
		"@tanstack/db": ">=0.6.1"
	},
	"devDependencies": {
		"@standard-schema/spec": "catalog:",
		"@tanstack/db": "catalog:",
		"bun-types": "catalog:",
		"zod": "catalog:"
	},
	"dependencies": {
		"@firtoz/maybe-error": "workspace:*"
	}
}
