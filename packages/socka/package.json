{
	"name": "socka",
	"version": "0.1.0",
	"description": "Standard Schema–first WebSocket RPC for browsers and Cloudflare Durable Objects",
	"main": "./src/core/index.ts",
	"module": "./src/core/index.ts",
	"types": "./src/core/index.ts",
	"exports": {
		"./core": {
			"types": "./src/core/index.ts",
			"import": "./src/core/index.ts",
			"require": "./src/core/index.ts"
		},
		"./client": {
			"types": "./src/client/index.ts",
			"import": "./src/client/index.ts",
			"require": "./src/client/index.ts"
		},
		"./react": {
			"types": "./src/react/index.ts",
			"import": "./src/react/index.ts",
			"require": "./src/react/index.ts"
		},
		"./do": {
			"types": "./src/do/index.ts",
			"import": "./src/do/index.ts",
			"require": "./src/do/index.ts"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"import": "./src/server/index.ts",
			"require": "./src/server/index.ts"
		}
	},
	"files": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/test-utils/**",
		"!test-setup.ts",
		"!bunfig.toml",
		"examples/**/*.ts",
		"skills",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsgo --noEmit -p ./tsconfig.json",
		"example:minimal": "bun ./examples/minimal-socka.ts",
		"test": "bun test",
		"lint": "biome check --write src",
		"lint:ci": "biome ci src && bun run intent:validate",
		"format": "biome format src --write",
		"intent:validate": "intent validate"
	},
	"keywords": [
		"websocket",
		"rpc",
		"standard-schema",
		"durable-objects",
		"cloudflare",
		"tanstack-intent"
	],
	"author": "Firtina Ozbalikchi <firtoz@github.com>",
	"license": "MIT",
	"homepage": "https://github.com/firtoz/fullstack-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/firtoz/fullstack-toolkit.git",
		"directory": "packages/socka"
	},
	"bugs": {
		"url": "https://github.com/firtoz/fullstack-toolkit/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@firtoz/maybe-error": "workspace:*",
		"@standard-schema/spec": "catalog:",
		"msgpackr": "catalog:"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@firtoz/websocket-do": "workspace:*",
		"hono": "catalog:",
		"react": "catalog:"
	},
	"peerDependenciesMeta": {
		"@firtoz/websocket-do": {
			"optional": true
		},
		"hono": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.8.9",
		"@tanstack/intent": "catalog:",
		"@testing-library/react": "^16.3.2",
		"@types/react": "catalog:",
		"bun-types": "catalog:",
		"happy-dom": "^20.8.9",
		"react-dom": "19.2.4",
		"typescript": "catalog:",
		"valibot": "catalog:",
		"zod": "catalog:"
	}
}
