{
	"name": "fullstack-toolkit-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "Monorepo for fullstack-toolkit packages including router utilities, error handling, and edge computing helpers",
	"workspaces": [
		"packages/*",
		"tests/*"
	],
	"catalog": {
		"@hono/zod-validator": "^0.7.6",
		"@playwright/test": "^1.58.2",
		"@react-router/dev": "^7.13.2",
		"@react-router/node": "^7.13.2",
		"@react-router/serve": "^7.13.2",
		"@standard-schema/spec": "^1.1.0",
		"bun-types": "^1.3.11",
		"typescript": "^6.0.2",
		"@tanstack/react-db": "0.1.79",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/node": "^25.5.0",
		"@cloudflare/vitest-pool-workers": "^0.13.5",
		"@cloudflare/workers-types": "^4.20260329.1",
		"@openrouter/sdk": "^0.10.2",
		"agents": "^0.8.7",
		"hono": "^4.12.9",
		"msgpackr": "^1.11.9",
		"react": "^19.2.4",
		"react-router": "^7.13.2",
		"vitest": "4.1.2",
		"wrangler": "^4.78.0",
		"@tanstack/db": "^0.6.1",
		"zod": "^4.3.6",
		"@sqlite.org/sqlite-wasm": "^3.51.2-build8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"drizzle-valibot": "^0.4.2",
		"playwright": "^1.58.2",
		"react-dom": "^19.2.4",
		"valibot": "^1.3.1",
		"vite": "^8.0.3",
		"zod-form-data": "^3.0.1"
	},
	"scripts": {
		"build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
		"ci": "TURBO_TELEMETRY_DISABLED=1 turbo run ci",
		"typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
		"dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev",
		"lint": "TURBO_TELEMETRY_DISABLED=1 turbo run lint",
		"lint:ci": "TURBO_TELEMETRY_DISABLED=1 turbo run lint:ci",
		"format": "TURBO_TELEMETRY_DISABLED=1 turbo run format",
		"test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
		"test:watch": "turbo run test:watch",
		"prepare": "husky",
		"changeset": "changeset",
		"version": "changeset version && bun install --lockfile-only && git add bun.lock",
		"release": "bun scripts/release.ts",
		"resolve-catalog": "bun scripts/resolve-catalog.ts",
		"restore-catalog": "bun scripts/restore-catalog.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.30.0",
		"@cloudflare/vitest-pool-workers": "catalog:",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@commitlint/types": "^20.5.0",
		"@types/node": "catalog:",
		"bun-types": "catalog:",
		"husky": "^9.1.7",
		"turbo": "^2.8.21",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "bun@1.3.1",
	"dependencies": {
		"@cloudflare/workers-types": "catalog:"
	}
}
