{
	"name": "fullstack-toolkit-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "Monorepo for fullstack-toolkit packages including router utilities, error handling, and edge computing helpers",
	"workspaces": [
		"packages/*",
		"tests/*",
		"examples/*"
	],
	"catalog": {
		"@hono/zod-validator": "^0.7.6",
		"@playwright/test": "^1.59.1",
		"@react-router/dev": "^7.14.1",
		"@react-router/node": "^7.14.1",
		"@react-router/serve": "^7.14.1",
		"@standard-schema/spec": "^1.1.0",
		"bun-types": "^1.3.12",
		"typescript": "^6.0.2",
		"@typescript/native-preview": "7.0.0-dev.20260416.2",
		"@tanstack/intent": "^0.0.29",
		"@tanstack/query-core": "5.99.0",
		"@tanstack/query-db-collection": "1.0.36",
		"@tanstack/react-db": "0.1.83",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/node": "^25.6.0",
		"@cloudflare/vitest-pool-workers": "^0.14.7",
		"@cloudflare/workers-types": "^4.20260416.2",
		"@openrouter/sdk": "^0.12.13",
		"agents": "^0.11.1",
		"hono": "^4.12.14",
		"msgpackr": "^1.11.9",
		"react": "^19.2.5",
		"react-router": "^7.14.1",
		"vitest": "4.1.4",
		"wrangler": "^4.83.0",
		"@tanstack/cloudflare-durable-objects-db-sqlite-persistence": "^0.1.9",
		"@tanstack/db": "^0.6.5",
		"zod": "^4.3.6",
		"@sqlite.org/sqlite-wasm": "^3.51.2-build9",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"drizzle-valibot": "^0.4.2",
		"playwright": "^1.59.1",
		"react-dom": "^19.2.5",
		"valibot": "^1.3.1",
		"vite": "^8.0.8",
		"zod-form-data": "^3.0.1"
	},
	"scripts": {
		"build": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=./packages/*",
		"ci": "TURBO_TELEMETRY_DISABLED=1 turbo run ci",
		"typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
		"dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev",
		"lint": "TURBO_TELEMETRY_DISABLED=1 turbo run lint",
		"lint:ci": "TURBO_TELEMETRY_DISABLED=1 turbo run lint:ci",
		"format": "TURBO_TELEMETRY_DISABLED=1 turbo run format",
		"test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
		"test:watch": "turbo run test:watch",
		"prepare": "husky",
		"changeset": "changeset",
		"version": "changeset version && bun install --lockfile-only && git add bun.lock",
		"release": "bun scripts/release.ts",
		"resolve-catalog": "bun scripts/resolve-catalog.ts",
		"restore-catalog": "bun scripts/restore-catalog.ts",
		"test:published-smoke:node": "cd tests/published-smoke/node-smoke && bun install && bun run smoke",
		"test:published-smoke:workers": "cd tests/published-smoke/cf-worker-smoke && bun install && bun run smoke",
		"test:published-smoke:react-router": "cd tests/published-smoke/react-router-smoke && bun install && bun run smoke",
		"test:published-smoke:all": "bun run test:published-smoke:node && bun run test:published-smoke:workers && bun run test:published-smoke:react-router"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"@biomejs/biome": "^2.4.12",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.30.0",
		"@cloudflare/vitest-pool-workers": "catalog:",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@commitlint/types": "^20.5.0",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"bun-types": "catalog:",
		"husky": "^9.1.7",
		"turbo": "^2.9.6",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "bun@1.3.11",
	"dependencies": {
		"@cloudflare/workers-types": "catalog:"
	}
}
