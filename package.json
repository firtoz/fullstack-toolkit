{
	"name": "fullstack-toolkit-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "Monorepo for fullstack-toolkit packages including router utilities, error handling, and edge computing helpers",
	"workspaces": [
		"packages/*",
		"tests/*"
	],
	"catalog": {
		"bun-types": "^1.3.8",
		"typescript": "^5.9.3",
		"@types/react": "^19.2.13",
		"@types/node": "^25.2.1",
		"@cloudflare/vitest-pool-workers": "^0.12.10",
		"@cloudflare/workers-types": "^4.20260207.0",
		"@openrouter/sdk": "^0.8.0",
		"agents": "^0.3.10",
		"hono": "^4.11.8",
		"msgpackr": "^1.11.8",
		"react": "^19.2.4",
		"react-router": "^7.13.0",
		"vitest": "3.2.4",
		"wrangler": "^4.63.0",
		"@tanstack/db": "^0.5.25",
		"zod": "^4.3.6",
		"@sqlite.org/sqlite-wasm": "^3.51.2-build6",
		"drizzle-orm": "^0.45.1",
		"zod-form-data": "^3.0.1"
	},
	"scripts": {
		"build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
		"ci": "TURBO_TELEMETRY_DISABLED=1 turbo run ci",
		"typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
		"dev": "turbo run dev",
		"lint": "TURBO_TELEMETRY_DISABLED=1 turbo run lint",
		"lint:ci": "TURBO_TELEMETRY_DISABLED=1 turbo run lint:ci",
		"format": "TURBO_TELEMETRY_DISABLED=1 turbo run format",
		"test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
		"test:watch": "turbo run test:watch",
		"prepare": "husky",
		"changeset": "changeset",
		"version": "changeset version && bun install --lockfile-only && git add bun.lock",
		"release": "bun scripts/release.ts",
		"resolve-catalog": "bun scripts/resolve-catalog.ts",
		"restore-catalog": "bun scripts/restore-catalog.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@cloudflare/vitest-pool-workers": "^0.12.10",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@commitlint/types": "^20.4.0",
		"@types/node": "catalog:",
		"bun-types": "catalog:",
		"husky": "^9.1.7",
		"turbo": "^2.8.3",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "bun@1.3.1",
	"dependencies": {
		"@cloudflare/workers-types": "^4.20260207.0"
	}
}
