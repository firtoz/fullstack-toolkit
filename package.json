{
	"name": "fullstack-toolkit-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "Monorepo for fullstack-toolkit packages including router utilities, error handling, and edge computing helpers",
	"workspaces": [
		"packages/*",
		"tests/*",
		"examples/*"
	],
	"catalog": {
		"@hono/zod-validator": "^0.8.0",
		"@playwright/test": "^1.61.1",
		"@react-router/dev": "^8.1.0",
		"@react-router/node": "^8.1.0",
		"@react-router/serve": "^8.1.0",
		"@standard-schema/spec": "^1.1.0",
		"bun-types": "^1.3.14",
		"typescript": "^6.0.3",
		"@typescript/native-preview": "7.0.0-dev.20260705.1",
		"@tanstack/intent": "^0.3.5",
		"@tanstack/query-core": "5.101.2",
		"@tanstack/query-db-collection": "1.0.46",
		"@tanstack/react-db": "0.1.92",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/node": "^26.1.0",
		"@cloudflare/vitest-pool-workers": "^0.18.0",
		"@cloudflare/workers-types": "^5.20260705.1",
		"@openrouter/sdk": "^0.13.24",
		"agents": "^0.17.3",
		"hono": "^4.12.27",
		"msgpackr": "^2.0.4",
		"react": "^19.2.7",
		"react-router": "^8.1.0",
		"vitest": "4.1.9",
		"wrangler": "^4.107.0",
		"@tanstack/cloudflare-durable-objects-db-sqlite-persistence": "^0.2.6",
		"@tanstack/db": "^0.6.14",
		"zod": "^4.4.3",
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"drizzle-valibot": "^0.4.2",
		"playwright": "^1.61.1",
		"react-dom": "^19.2.7",
		"valibot": "^1.4.2",
		"vite": "^8.1.3",
		"zod-form-data": "^3.0.3"
	},
	"scripts": {
		"build": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=./packages/*",
		"ci": "TURBO_TELEMETRY_DISABLED=1 turbo run ci",
		"typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
		"dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev",
		"lint": "TURBO_TELEMETRY_DISABLED=1 turbo run lint",
		"lint:ci": "TURBO_TELEMETRY_DISABLED=1 turbo run lint:ci",
		"format": "TURBO_TELEMETRY_DISABLED=1 turbo run format",
		"test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
		"test:watch": "turbo run test:watch",
		"prepare": "husky",
		"changeset": "changeset",
		"version": "changeset version && bun install --lockfile-only && git add bun.lock",
		"release": "bun scripts/release.ts",
		"resolve-catalog": "bun scripts/resolve-catalog.ts",
		"restore-catalog": "bun scripts/restore-catalog.ts",
		"test:published-smoke:node": "cd tests/published-smoke/node-smoke && bun install && bun run smoke",
		"test:published-smoke:workers": "cd tests/published-smoke/cf-worker-smoke && bun install && bun run smoke",
		"test:published-smoke:react-router": "cd tests/published-smoke/react-router-smoke && bun install && bun run smoke",
		"test:published-smoke:all": "bun run test:published-smoke:node && bun run test:published-smoke:workers && bun run test:published-smoke:react-router"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"@biomejs/biome": "^2.5.2",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@cloudflare/vitest-pool-workers": "catalog:",
		"@commitlint/cli": "^21.2.0",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/types": "^21.2.0",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"bun-types": "catalog:",
		"husky": "^9.1.7",
		"turbo": "^2.10.3",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "bun@1.3.11",
	"dependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@openrouter/sdk": "^0.13.24",
		"agents": "^0.17.3"
	}
}
