# Exit immediately if any command fails
set -e

# Skip hooks in CI environment
if [ -n "$CI" ]; then
  echo "Skipping pre-commit hooks in CI environment"
  exit 0
fi

# Add bun to PATH for git hooks
export PATH="$HOME/.bun/bin:$PATH"

# Run lint-staged (linting with auto-fix)
npx lint-staged

# Run type checking on the entire project
echo "Running type checks..."
bun run typecheck
