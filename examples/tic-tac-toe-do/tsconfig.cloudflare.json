{
	"extends": "./tsconfig.json",
	"include": [
		"src/worker.ts",
		"src/do.ts",
		"src/contract.ts",
		"src/game.ts",
		"worker-configuration.d.ts"
	],
	"compilerOptions": {
		"composite": true,
		"strict": true,
		"lib": ["ES2022"],
		"types": ["@cloudflare/vitest-pool-workers"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"rootDirs": ["."],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true
	}
}
