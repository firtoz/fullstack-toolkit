{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chatroom-do",
	"main": "src/worker.ts",
	"compatibility_date": "2025-10-01",
	"assets": {
		"directory": "./public"
	},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoomDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatRoomDO"]
		}
	]
}
