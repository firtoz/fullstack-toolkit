{
	"name": "tic-tac-toe-hono",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Minimal tic-tac-toe over socka on Hono + @hono/node-ws (self-contained example)",
	"scripts": {
		"dev": "bun run build:client && bun --watch src/server.ts",
		"start": "bun run build:client && bun src/server.ts",
		"build:client": "bun build ./src/client.ts --outfile=public/client.js --target=browser --minify",
		"typecheck": "tsgo --noEmit -p ./tsconfig.json"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.8",
		"@hono/node-ws": "^1.3.1",
		"hono": "catalog:",
		"@firtoz/socka": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"typescript": "catalog:"
	}
}
