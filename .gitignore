# Dependencies
node_modules/ 

# Build outputs (we ship TypeScript files directly)
dist/
build/

# Example apps: `bun run build:client` → public/client.js
examples/**/public/client.js

# TypeScript incremental build caches (do not commit)
*.tsbuildinfo

# Environment variables
.env.local
.env.*.local 

# Turbo cache
.turbo

# Wrangler local dev
.wrangler

# Playwright and e2e artifacts
test-results/
playwright-report/

# Cursor agent debug ingest / session logs (local only)
.cursor/debug.log
.cursor/debug-*.log

# tsup may emit a temp bundled config next to tsup.config.ts (do not commit)
tsup.config.bundled_*.mjs