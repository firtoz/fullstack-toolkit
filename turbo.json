{
	"$schema": "./node_modules/turbo/schema.json",
	"ui": "tui",
	"daemon": false,
	"tasks": {
		"build": {
			"outputs": ["dist/**"],
			"outputLogs": "new-only"
		},
		"ci": {
			"dependsOn": ["typecheck", "lint:ci", "test"]
		},
		"typecheck": {
			"outputLogs": "new-only"
		},
		"lint": {
			"outputLogs": "new-only"
		},
		"lint:ci": {
			"outputLogs": "new-only"
		},
		"format": {
			"outputLogs": "new-only"
		},
		"test": {
			"outputLogs": "new-only",
			"env": [
				"OPENROUTER_API_KEY",
				"CLOUDFLARE_ACCOUNT_ID",
				"AI_GATEWAY_NAME",
				"AI_GATEWAY_TOKEN"
			]
		},
		"test:ci": {
			"outputLogs": "new-only"
		},
		"typegen": {
			"outputLogs": "new-only"
		},
		"test:watch": {
			"persistent": true,
			"cache": false
		},
		"test:e2e": {
			"outputLogs": "new-only",
			"passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
