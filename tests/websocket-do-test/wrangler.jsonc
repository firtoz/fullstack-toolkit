{
	// JSON Schema enables IDE autocomplete and validation for wrangler config
	// Points to the schema bundled with wrangler package
	// Reference: https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "../../node_modules/wrangler/config-schema.json",

	"name": "websocket-do-test",
	"main": "src/websocket/test-fixtures/worker.ts",
	"compatibility_date": "2025-10-01",

	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoomDO"
			},
			{
				"name": "SCHEMA_CHAT_ROOM",
				"class_name": "StandardSchemaChatRoomDO"
			},
			{
				"name": "SCHEMA_CHAT_ROOM_JSON",
				"class_name": "StandardSchemaChatRoomDO_JSON"
			},
			{
				"name": "SCHEMA_CHAT_ROOM_DYNAMIC",
				"class_name": "StandardSchemaChatRoomDO_Dynamic"
			},
			{
				"name": "SCHEMA_CHAT_ROOM_CUSTOM_ERROR",
				"class_name": "StandardSchemaChatRoomDO_CustomProtocolError"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["ChatRoomDO"]
		},
		{
			"tag": "v2",
			"new_classes": ["ZodChatRoomDO", "ZodChatRoomDO_JSON"]
		},
		{
			"tag": "v3",
			"new_classes": ["ZodChatRoomDO_Dynamic"]
		},
		{
			"tag": "v4",
			"new_classes": ["ZodChatRoomDO_CustomProtocolError"]
		},
		{
			"tag": "v5",
			"renamed_classes": [
				{
					"from": "ZodChatRoomDO",
					"to": "StandardSchemaChatRoomDO"
				},
				{
					"from": "ZodChatRoomDO_JSON",
					"to": "StandardSchemaChatRoomDO_JSON"
				},
				{
					"from": "ZodChatRoomDO_Dynamic",
					"to": "StandardSchemaChatRoomDO_Dynamic"
				},
				{
					"from": "ZodChatRoomDO_CustomProtocolError",
					"to": "StandardSchemaChatRoomDO_CustomProtocolError"
				}
			]
		}
	]
}
