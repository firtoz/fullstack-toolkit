{
	"extends": "./tsconfig.json",
	"include": [
		"src/**/*.ts",
		"worker-configuration.d.ts",
		"../socka-server-test/src/fixtures/session-game-contract.ts",
		"../socka-server-test/src/fixtures/session-game-state.ts",
		"../socka-server-test/src/fixtures/session-game-flow.ts"
