{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "durable-sqlite-sync-example-worker",
	"main": "src/worker.ts",
	"compatibility_date": "2025-10-01",
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "TODO_SYNC",
				"class_name": "TodoSyncDO"
			},
			{
				"name": "VIRTUAL_PROPS_TS_DO",
				"class_name": "VirtualPropsTanstackDO"
			},
			{
				"name": "VIRTUAL_PROPS_DRIZZLE_DO",
				"class_name": "VirtualPropsDrizzleDO"
			},
			{
				"name": "VIRTUAL_PROPS_WS_TS_DO",
				"class_name": "VirtualPropsWsTanstackDO"
			},
			{
				"name": "VIRTUAL_PROPS_WS_DRIZZLE_DO",
				"class_name": "VirtualPropsWsDrizzleDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TodoSyncDO"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"VirtualPropsTanstackDO",
				"VirtualPropsDrizzleDO"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"VirtualPropsWsTanstackDO",
				"VirtualPropsWsDrizzleDO"
			]
		}
	]
}
