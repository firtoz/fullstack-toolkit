{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"types": ["@cloudflare/workers-types", "node", "vite/client"],
		"paths": {
			"@firtoz/db-helpers": ["../../packages/db-helpers/src/index.ts"],
			"@firtoz/db-helpers/*": ["../../packages/db-helpers/src/*"],
			"@firtoz/drizzle-indexeddb": ["../../packages/drizzle-indexeddb/src/index.ts"],
			"@firtoz/drizzle-indexeddb/*": ["../../packages/drizzle-indexeddb/src/*"],
			"@firtoz/drizzle-sqlite-wasm": ["../../packages/drizzle-sqlite-wasm/src/index.ts"],
			"@firtoz/drizzle-sqlite-wasm/*": ["../../packages/drizzle-sqlite-wasm/src/*"],
			"@firtoz/drizzle-utils": ["../../packages/drizzle-utils/src/index.ts"],
			"@firtoz/drizzle-utils/*": ["../../packages/drizzle-utils/src/*"],
			"@firtoz/idb-collections": ["../../packages/idb-collections/src/index.ts"],
			"@firtoz/idb-collections/*": ["../../packages/idb-collections/src/*"],
			"@firtoz/maybe-error": ["../../packages/maybe-error/src/index.ts"],
			"@firtoz/maybe-error/*": ["../../packages/maybe-error/src/*"],
			"@firtoz/router-toolkit": ["../../packages/router-toolkit/src/index.ts"],
			"@firtoz/router-toolkit/*": ["../../packages/router-toolkit/src/*"],
			"@firtoz/worker-helper": ["../../packages/worker-helper/src/index.ts"],
			"@firtoz/worker-helper/*": ["../../packages/worker-helper/src/*"],
			"@firtoz/collection-sync": ["../../packages/collection-sync/src/index.ts"],
			"@firtoz/collection-sync/*": ["../../packages/collection-sync/src/*"],
			"@firtoz/drizzle-durable-sqlite": ["../../packages/drizzle-durable-sqlite/src/index.ts"],
			"@firtoz/drizzle-durable-sqlite/*": ["../../packages/drizzle-durable-sqlite/src/*"],
			"@firtoz/websocket-do": ["../../packages/websocket-do/src/index.ts"],
			"@firtoz/websocket-do/*": ["../../packages/websocket-do/src/*"],
			"@firtoz/hono-fetcher": ["../../packages/hono-fetcher/src/index.ts"],
			"@firtoz/hono-fetcher/*": ["../../packages/hono-fetcher/src/*"]
		}
	},
	"include": ["app/**/*", "src/**/*", "worker-configuration.d.ts"],
	"exclude": ["node_modules", "dist"]
}
