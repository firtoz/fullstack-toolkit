{
	"name": "durable-sqlite-sync-example",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"db:generate": "drizzle-kit generate",
		"dev": "react-router dev --port 5197 --host 127.0.0.1",
		"typegen": "react-router typegen && bun run cf-typegen",
		"cf-typegen": "bun --cwd ../../packages/worker-helper cf-typegen $(pwd)",
		"typecheck": "react-router typegen && tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write app src",
		"lint:ci": "biome ci app src",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@firtoz/collection-sync": "workspace:*",
		"@firtoz/db-helpers": "workspace:*",
		"@firtoz/drizzle-durable-sqlite": "workspace:*",
		"@firtoz/drizzle-sqlite-wasm": "workspace:*",
		"@firtoz/drizzle-utils": "workspace:*",
		"@firtoz/hono-fetcher": "workspace:*",
		"@firtoz/idb-collections": "workspace:*",
		"@firtoz/maybe-error": "workspace:*",
		"@firtoz/websocket-do": "workspace:*",
		"@hono/zod-validator": "catalog:",
		"@react-router/node": "catalog:",
		"@react-router/serve": "catalog:",
		"@tanstack/cloudflare-durable-objects-db-sqlite-persistence": "catalog:",
		"@tanstack/db": "catalog:",
		"@tanstack/query-core": "catalog:",
		"@tanstack/query-db-collection": "catalog:",
		"@tanstack/react-db": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"msgpackr": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router": "catalog:",
		"@firtoz/socka": "workspace:*",
		"superjson": "^2.2.6",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.0",
		"@cloudflare/workers-types": "catalog:",
		"@playwright/test": "catalog:",
		"@react-router/dev": "catalog:",
		"@standard-schema/spec": "^1.1.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-kit": "catalog:",
		"playwright": "catalog:",
		"typescript": "catalog:",
