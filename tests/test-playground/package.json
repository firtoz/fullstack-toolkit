{
	"name": "test-playground",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev --port 5198 --host 127.0.0.1",
		"start": "react-router-serve ./build/server/index.js",
		"typegen": "react-router typegen",
		"typecheck": "react-router typegen && tsgo --noEmit -p ./tsconfig.json",
		"lint": "biome check --write app src",
		"lint:ci": "biome ci app src",
		"format": "biome format app src --write",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "bun test src/",
		"test:watch": "bun test --watch",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug"
	},
	"dependencies": {
		"@firtoz/db-helpers": "workspace:*",
		"@firtoz/drizzle-indexeddb": "workspace:*",
		"@firtoz/drizzle-sqlite-wasm": "workspace:*",
		"@firtoz/drizzle-utils": "workspace:*",
		"@firtoz/idb-collections": "workspace:*",
		"@firtoz/maybe-error": "workspace:*",
		"@firtoz/router-toolkit": "workspace:*",
		"@firtoz/worker-helper": "workspace:*",
		"@react-router/node": "catalog:",
		"@react-router/serve": "catalog:",
		"@sqlite.org/sqlite-wasm": "catalog:",
		"@tanstack/db": "catalog:",
		"@tanstack/query-core": "catalog:",
		"@tanstack/query-db-collection": "catalog:",
		"@tanstack/react-db": "catalog:",
		"drizzle-orm": "catalog:",
		"isbot": "^5.1.36",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router": "catalog:",
		"test-schema": "workspace:*",
		"zod": "catalog:",
		"zod-form-data": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@react-router/dev": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"bun-types": "catalog:",
		"playwright": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0"
	}
}
