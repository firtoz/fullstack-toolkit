# Copy to `.env.local` in this directory. `tests/setup.ts` loads `.env` and `.env.local`
# before tests run (no manual `export` needed).

# OpenRouter API Key (required for chat agent to make LLM calls)
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Cloudflare AI Gateway Configuration (required)
# See https://developers.cloudflare.com/ai-gateway/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
AI_GATEWAY_NAME=your_gateway_name
AI_GATEWAY_TOKEN=your_gateway_token
