{
	"name": "chat-agent-e2e",
	"version": "1.0.4",
	"private": true,
	"description": "E2E tests for ChatAgent using Playwright and wrangler dev",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8791 --inspector-port 9230",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typegen": "bun run cf-typegen",
		"cf-typegen": "bun --cwd ../../packages/worker-helper cf-typegen $(pwd)"
	},
	"dependencies": {
		"@firtoz/chat-agent": "workspace:*",
		"@firtoz/chat-agent-drizzle": "workspace:*",
		"hono": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	}
}
