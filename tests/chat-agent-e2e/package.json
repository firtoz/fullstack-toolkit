{
	"name": "chat-agent-e2e",
	"version": "1.0.3",
	"private": true,
	"description": "E2E tests for ChatAgent using Playwright and wrangler dev",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typegen": "bun run cf-typegen",
		"cf-typegen": "bun --cwd ../../packages/worker-helper cf-typegen $(pwd)"
	},
	"dependencies": {
		"@firtoz/chat-agent": "workspace:*",
		"hono": "^4.11.9"
	},
	"devDependencies": {
		"@types/bun": "^1.3.9",
		"typescript": "^5.9.3",
		"wrangler": "^4.65.0"
	}
}
