{
	"name": "chat-agent-e2e",
	"version": "1.0.3",
	"private": true,
	"description": "E2E tests for ChatAgent using Playwright and wrangler dev",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typegen": "bun run cf-typegen",
		"cf-typegen": "bun --cwd ../../packages/worker-helper cf-typegen $(pwd)"
	},
	"dependencies": {
		"@firtoz/chat-agent": "workspace:*",
		"@firtoz/chat-agent-drizzle": "workspace:*",
		"hono": "^4.12.9"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"typescript": "^6.0.2",
		"wrangler": "^4.77.0"
	}
}
